# Copy to backend/.env and fill in. Every setting is optional except LLM_API_KEY (and JWT_SECRET in production).

# --- LLM: any OpenAI-compatible API. OpenRouter gives one key for Claude, Gemini, GPT, Llama, ... ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model that writes answers, and a cheaper/faster one for routing, planning, grading and validation.
# Use any model id from https://openrouter.ai/models (e.g. anthropic/..., google/..., openai/...).
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# Optional per-agent overrides: ROUTER_MODEL, PLANNER_MODEL, GRADER_MODEL, GENERATOR_MODEL, VALIDATOR_MODEL

# --- Auth: required in production. Generate with: openssl rand -hex 32 ---
JWT_SECRET=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Storage. Defaults: SQLite + embedded Qdrant under ./data (no setup needed) ---
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Embeddings ---
# fastembed runs intfloat/multilingual-e5-large locally on CPU (downloads ~2 GB once, free).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# Or use an OpenAI-compatible embeddings API instead (no local model):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=<model id>
# EMBEDDING_DIM=<its dimension>
# EMBEDDING_BASE_URL=   (defaults to LLM_BASE_URL)
# EMBEDDING_API_KEY=    (defaults to LLM_API_KEY)

# --- Documents & OCR ---
MAX_UPLOAD_MB=25
OCR_ENABLED=true
OCR_LANGUAGES=eng+hin+tam+tel+kan+mal+ben+guj+pan+mar+ori+urd
